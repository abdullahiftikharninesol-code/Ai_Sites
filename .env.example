NODE_ENV=development
DEFAULT_AGENT_PROVIDER=mock
DEFAULT_EXECUTION_PROVIDER=mock
EXECUTION_PROVIDER=mock
LOCAL_EXECUTION_ROOT=.local-sandboxes
LOCAL_EXECUTION_KEEP_WORKSPACE=false
LOCAL_PREVIEW_HOST=127.0.0.1
LOCAL_PREVIEW_START_TIMEOUT_MS=15000
LOCAL_COMMAND_TIMEOUT_MS=120000
LOCAL_MAX_LOG_BYTES=256000
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api
DAYTONA_TARGET=
DAYTONA_DEFAULT_CPU=2
DAYTONA_DEFAULT_MEMORY_GB=4
DAYTONA_DEFAULT_DISK_GB=10
DAYTONA_SANDBOX_TTL_MINUTES=60
DAYTONA_COMMAND_TIMEOUT_MS=180000
DAYTONA_PREVIEW_START_TIMEOUT_MS=30000
DAYTONA_PREVIEW_URL_TTL_SECONDS=3600
DAYTONA_MAX_LOG_BYTES=128000
DATABASE=
LOCAL_HOSTING_HOST=127.0.0.1
LOCAL_HOSTING_PORT=8088
DEFAULT_HOSTING_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_AGENT_MODEL=gpt-5.6
OPENAI_AGENT_REASONING_EFFORT=medium
OPENAI_AGENT_TIMEOUT_MS=180000
OPENAI_AGENT_MAX_RETRIES=2
ANTHROPIC_API_KEY=
ANTHROPIC_AGENT_MODEL=claude-opus-4-6
ANTHROPIC_AGENT_TIMEOUT_MS=60000
ANTHROPIC_AGENT_MAX_RETRIES=2
# gemini-2.5-flash was retired for new users (Google now returns HTTP 404 and
# redirects to gemini-3.6-flash); gemini-3.6-flash has free-tier quota, larger
# models generally require billing enabled on the API key's project.
GEMINI_API_KEY=
GEMINI_AGENT_MODEL=gemini-3.6-flash
GEMINI_AGENT_TIMEOUT_MS=60000
GEMINI_AGENT_MAX_RETRIES=1
GEMINI_AGENT_MIN_REQUEST_INTERVAL_MS=0
GEMINI_AGENT_THINKING_BUDGET=2048
GEMINI_AGENT_MAX_OUTPUT_TOKENS=16384
DEEPSEEK_API_KEY=
DEEPSEEK_AGENT_MODEL=deepseek-v4-pro
DEEPSEEK_AGENT_TIMEOUT_MS=60000
DEEPSEEK_AGENT_MAX_RETRIES=2
XAI_API_KEY=
XAI_AGENT_MODEL=grok-4.6
XAI_AGENT_TIMEOUT_MS=60000
XAI_AGENT_MAX_RETRIES=2
KIMI_API_KEY=
KIMI_AGENT_MODEL=kimi-k2.6
KIMI_AGENT_TIMEOUT_MS=60000
KIMI_AGENT_MAX_RETRIES=2
GROQ_API_KEY=
GROQ_AGENT_MODEL=openai/gpt-oss-120b
GROQ_AGENT_TIMEOUT_MS=60000
GROQ_AGENT_MAX_RETRIES=1
GROQ_AGENT_PARALLEL_TOOL_CALLS=true
OPENROUTER_API_KEY=
OPENROUTER_AGENT_MODEL=google/gemini-2.5-flash
OPENROUTER_AGENT_TIMEOUT_MS=60000
OPENROUTER_AGENT_MAX_RETRIES=1
SITES_DEV_AGENT_PROVIDER=mock
SITES_DEV_AGENT_PLANNING=false
# Inference Efficiency & Run Budget
SITES_MAX_AGENT_CALLS_PER_RUN=3
SITES_MAX_REPAIR_ATTEMPTS=1
SITES_MAX_TOOL_ITERATIONS=5
SITES_PLANNER_MODEL=
SITES_PLANNER_PROVIDER=
SITES_GENERATOR_MODEL=
SITES_GENERATOR_PROVIDER=
SITES_REPAIR_MODEL=
SITES_REPAIR_PROVIDER=
MAX_VISUAL_REPAIR_ATTEMPTS=1
VISUAL_QA_STRICT=false
SITES_DEV_VISUAL_REPAIR_ATTEMPTS=0
SITES_PLAYGROUND_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
NEXT_PUBLIC_SITES_API_URL=http://127.0.0.1:4310
NEXT_PUBLIC_SITES_SOCKET_URL=http://127.0.0.1:4310
