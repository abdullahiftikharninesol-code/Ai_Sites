NODE_ENV=development
DEFAULT_AGENT_PROVIDER=mock
DEFAULT_EXECUTION_PROVIDER=mock
EXECUTION_PROVIDER=mock
LOCAL_EXECUTION_ROOT=.local-sandboxes
LOCAL_EXECUTION_KEEP_WORKSPACE=false
LOCAL_PREVIEW_HOST=127.0.0.1
LOCAL_PREVIEW_START_TIMEOUT_MS=15000
LOCAL_COMMAND_TIMEOUT_MS=120000
LOCAL_MAX_LOG_BYTES=256000
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api
DAYTONA_TARGET=
DAYTONA_DEFAULT_CPU=2
DAYTONA_DEFAULT_MEMORY_GB=4
DAYTONA_DEFAULT_DISK_GB=10
DAYTONA_SANDBOX_TTL_MINUTES=60
DAYTONA_COMMAND_TIMEOUT_MS=180000
DAYTONA_PREVIEW_START_TIMEOUT_MS=30000
DAYTONA_PREVIEW_URL_TTL_SECONDS=3600
DAYTONA_MAX_LOG_BYTES=128000
DATABASE=
# Must point to the same Redis deployment used by GetChatly. Quota cache
# invalidation and userCreditQuota emission are disabled when omitted.
REDIS_URL=
# Must match GetChatly. When omitted, Sites uses NODE_ENV || "development".
REDIS_CACHE_ENV=
# Existing GetChatly GCS bucket used by the internal Sites template publisher
# and public preview URL resolution. Authentication remains external ADC config.
SITES_TEMPLATE_GCS_BUCKET=bucket-chatbot-ni
# GetChatly user JWT secret (same value as the GetChatly backend JWTKEY). Required;
# there is no fallback and authenticated Sites routes fail closed without it.
JWTKEY=
# Authenticated production HTTP boundary (npm run start:api).
# Configure explicit GetChatly origins; empty denies cross-origin browser access.
SITES_HTTP_HOST=127.0.0.1
SITES_HTTP_PORT=4312
SITES_HTTP_ORIGINS=
# Must be the existing project snapshot data root, not a new empty directory.
SITES_DATA_ROOT=.sites-runtime/playground
LOCAL_HOSTING_HOST=127.0.0.1
LOCAL_HOSTING_PORT=8088
DEFAULT_HOSTING_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_AGENT_MODEL=gpt-5.6
OPENAI_AGENT_REASONING_EFFORT=medium
OPENAI_AGENT_TIMEOUT_MS=180000
OPENAI_AGENT_MAX_RETRIES=2
ANTHROPIC_API_KEY=
ANTHROPIC_AGENT_MODEL=claude-opus-4-6
ANTHROPIC_AGENT_TIMEOUT_MS=60000
ANTHROPIC_AGENT_MAX_RETRIES=2
# gemini-2.5-flash was retired for new users (Google now returns HTTP 404 and
# redirects to gemini-3.6-flash); gemini-3.6-flash has free-tier quota, larger
# models generally require billing enabled on the API key's project.
GEMINI_API_KEY=
GEMINI_AGENT_MODEL=gemini-3.6-flash
GEMINI_AGENT_TIMEOUT_MS=60000
GEMINI_AGENT_MAX_RETRIES=1
GEMINI_AGENT_MIN_REQUEST_INTERVAL_MS=0
GEMINI_AGENT_THINKING_BUDGET=2048
GEMINI_AGENT_MAX_OUTPUT_TOKENS=16384
DEEPSEEK_API_KEY=
DEEPSEEK_AGENT_MODEL=deepseek-v4-pro
DEEPSEEK_AGENT_TIMEOUT_MS=60000
DEEPSEEK_AGENT_MAX_RETRIES=2
XAI_API_KEY=
XAI_AGENT_MODEL=grok-4.6
XAI_AGENT_TIMEOUT_MS=60000
XAI_AGENT_MAX_RETRIES=2
KIMI_API_KEY=
KIMI_AGENT_MODEL=kimi-k2.6
KIMI_AGENT_TIMEOUT_MS=60000
KIMI_AGENT_MAX_RETRIES=2
GROQ_API_KEY=
GROQ_AGENT_MODEL=openai/gpt-oss-120b
GROQ_AGENT_TIMEOUT_MS=60000
GROQ_AGENT_MAX_RETRIES=1
GROQ_AGENT_PARALLEL_TOOL_CALLS=true
OPENROUTER_API_KEY=
OPENROUTER_AGENT_MODEL=google/gemini-2.5-flash
OPENROUTER_AGENT_TIMEOUT_MS=60000
OPENROUTER_AGENT_MAX_RETRIES=1
SITES_DEV_AGENT_PROVIDER=mock
SITES_DEV_AGENT_PLANNING=false
# Inference Efficiency & Run Budget
SITES_MAX_AGENT_CALLS_PER_RUN=3
SITES_MAX_REPAIR_ATTEMPTS=1
SITES_MAX_TOOL_ITERATIONS=5
SITES_PLANNER_MODEL=
SITES_PLANNER_PROVIDER=
SITES_GENERATOR_MODEL=
SITES_GENERATOR_PROVIDER=
SITES_REPAIR_MODEL=
SITES_REPAIR_PROVIDER=
MAX_VISUAL_REPAIR_ATTEMPTS=1
VISUAL_QA_STRICT=false
SITES_DEV_VISUAL_REPAIR_ATTEMPTS=0
SITES_PLAYGROUND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://127.0.0.1:5173,http://localhost:5173
NEXT_PUBLIC_SITES_API_URL=http://127.0.0.1:4310
NEXT_PUBLIC_SITES_SOCKET_URL=http://127.0.0.1:4310

# Vercel Connectable Account Integration (Stage 1: account connection only).
# All six are required; when any is missing or invalid the integration is disabled
# and /api/integrations/vercel/* fails closed. Never commit real values.
# Client ID (oac_...) and Client Secret from the Vercel Integration Console.
VERCEL_INTEGRATION_CLIENT_ID=
VERCEL_INTEGRATION_CLIENT_SECRET=
# URL slug of the integration (https://vercel.com/integrations/<slug>).
VERCEL_INTEGRATION_SLUG=
# Must exactly match the Redirect URL in the Integration Console.
VERCEL_INTEGRATION_REDIRECT_URI=http://localhost:4310/api/integrations/vercel/callback
# AI Sites page the browser returns to (?vercel=connected | ?vercel=error&reason=...).
VERCEL_INTEGRATION_RETURN_URL=
# 32 random bytes as base64 or hex, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Encrypts Vercel access tokens at rest; changing it makes stored tokens unreadable.
VERCEL_TOKEN_ENCRYPTION_KEY=

# Vercel publishing (Stage 2: production build preparation; nothing is deployed).
# Creating/reusing the Vercel project during preparation calls the live Vercel API with
# the user's own token. Keep false until live project creation is explicitly approved.
VERCEL_PROJECT_LINKING_ENABLED=false
# Stage 3: deploy prepared sites to the user's own Vercel account. Requires BOTH this flag
# and VERCEL_PROJECT_LINKING_ENABLED=true; any other value refuses live publishing (403).
VERCEL_LIVE_PUBLISHING_ENABLED=false
# Concurrent live publishes on this server (clamped 1-4).
SITES_PUBLISH_MAX_CONCURRENT_DEPLOYS=1
# Stage 5B: observe-only reconciliation of unverified publishes. Never scheduled by the dev
# server; a future scheduler calls VercelPublishService.reconcilePass(). Keep false.
# See docs/PUBLISHING_RELIABILITY.md.
SITES_PUBLISH_RECONCILE_ENABLED=false
# Production builds run on this host with the local execution provider. That is NOT a
# sandbox: build tooling can read the filesystem and reach the network. Until isolated
# execution exists, only these comma-separated site IDs may build; empty = no site (fail closed).
SITES_PUBLISH_TRUSTED_SITE_IDS=
# Bounds for local production builds (defaults shown; values are clamped).
SITES_PUBLISH_MAX_CONCURRENT=1
SITES_PUBLISH_INSTALL_TIMEOUT_MS=300000
SITES_PUBLISH_BUILD_TIMEOUT_MS=180000
SITES_PUBLISH_BUILD_MEMORY_MB=1536
SITES_PUBLISH_MAX_OUTPUT_MB=30

# Stage 5A: where publishing builds run. "local" (default) = this host, trusted site IDs only.
# "cloud" = a Cloud Run job whose worker runs npm ci and the Vite build inside Cloud Run
# sandboxes (no network, no metadata credentials). Cloud builds accept any owner's eligible
# site ONLY after the backend verifies the live job, the worker's IAM and a passing probe
# attestation (npm run publish:cloud-attest). Incomplete settings refuse every build; there is
# never a fallback to local execution. See docs/PUBLISHING_CLOUD_BUILDS.md.
SITES_PUBLISH_BUILD_PROVIDER=local
SITES_CLOUD_BUILD_PROJECT_ID=
SITES_CLOUD_BUILD_REGION=
SITES_CLOUD_BUILD_JOB=
SITES_CLOUD_BUILD_CONTAINER=worker
# Worker image pinned by digest: REGISTRY/PATH@sha256:<64 hex>
SITES_CLOUD_BUILD_IMAGE=
# Dedicated worker identity with NO IAM roles (the job runs as it).
SITES_CLOUD_BUILD_WORKER_SERVICE_ACCOUNT=
# Dedicated bucket for per-build transfer objects only (never the template bucket).
SITES_CLOUD_BUILD_TRANSFER_BUCKET=
# Bounds (defaults shown; values are clamped).
SITES_CLOUD_BUILD_TIMEOUT_SECONDS=900
SITES_CLOUD_BUILD_MAX_CPU=2
SITES_CLOUD_BUILD_MAX_MEMORY_MIB=4096
SITES_CLOUD_BUILD_DAILY_LIMIT_PER_OWNER=20
SITES_CLOUD_BUILD_ATTESTATION_MAX_AGE_HOURS=168
SITES_CLOUD_BUILD_POLL_INTERVAL_MS=5000
